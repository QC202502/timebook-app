# No database or API key required. All paths must be absolute.
# Default home is outside the checkout; see README.
# TIME_LEDGER_HOME=/absolute/path/to/time-ledger-data
# Optional filesystem access: disabled until explicitly configured.
TIME_LEDGER_CODEX_ENABLED=0
# TIME_LEDGER_CODEX_SESSIONS=/absolute/path/to/sessions
# TIME_LEDGER_CODEX_MEMORY=/absolute/path/to/empty-or-memory-directory
# TIME_LEDGER_CODEX_FIRST_DAY=2030-01-01
NEXT_TELEMETRY_DISABLED=1
